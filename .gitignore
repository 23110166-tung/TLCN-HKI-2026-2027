*.xlsx
*.pptx
*.pdf
!sample/*.docx

# ---- Virtual environments ----
venv/
.venv/
env/

# ---- IDE & OS ----
.vscode/
.idea/
*.DS_Store
Thumbs.db
desktop.ini

# ---- Jupyter checkpoints ----
